);

function formatText(str) {
  return str
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}

function sendClickUtagEvent(event, category, action, label) {
  utag.track("link", {
    tealium_event: event,
    event_category: category,
    event_action: action,
    event_label: label,
    debug_mode: 1,
  });
}

